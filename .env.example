# Bu dosyayı ".env" adıyla kopyalayıp düzenleyin. .env Git'e yüklenmez (şifre içerir).
# PostgreSQL için: scripts\postgres_kurulum.ps1 bu dosyayı otomatik oluşturur.

# SQLite (varsayılan, kurulum gerektirmez):
# DATABASE_URL=sqlite:///./siirt_fistik.db

# PostgreSQL:
DATABASE_URL=postgresql+psycopg://fistik:SIFRE@localhost:5432/siirt_fistik
# Testleri PostgreSQL üzerinde çalıştırmak için (her testte şema sıfırlanır, ayrı veritabanı kullanın):
TEST_DATABASE_URL=postgresql+psycopg://fistik:SIFRE@localhost:5432/siirt_fistik_test
